<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DONGWAL - Cyber-edition Anime API</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230a0a12'/><text x='50' y='68' font-size='55' text-anchor='middle' fill='%2300f0ff' font-family='monospace' font-weight='bold' text-shadow='0 0 20px %23ff00de'>DW</text></svg>">
  <meta name="theme-color" content="#0a0a12">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/index.css">
</head>
<body>
  <div class="scanlines"></div>

  <header>
    <div class="header-inner">
      <div class="logo" onclick="showSection('home')">
        DONGWAL
        <span>CYBER-EDITION ANIME API</span>
      </div>
      <div class="nav-links">
        <button class="nav-btn active" onclick="showSection('home')">HOME</button>
        <button class="nav-btn" onclick="showSection('ongoing')">ONGOING</button>
        <button class="nav-btn" onclick="showSection('completed')">COMPLETED</button>
        <button class="nav-btn" onclick="showSection('genres')">GENRES</button>
        <button class="nav-btn" onclick="showSection('schedule')">SCHEDULE</button>
        <button class="nav-btn mag" onclick="showSection('api-doc')">API DOCS</button>
      </div>
    </div>
  </header>

  <div class="search-bar">
    <div class="search-wrap">
      <input type="text" id="searchInput" placeholder=">> SEARCH ALL SOURCES..." onkeydown="if(event.key==='Enter')doSearch()">
      <button onclick="doSearch()">SCAN</button>
    </div>
  </div>

  <main>
    <div id="sec-home" class="section active">
      <div id="hero-slider" class="hero-slider"></div>
      <div class="section-title" style="margin-top:24px">Watch History <span class="count" id="history-count"></span><span class="count" style="margin-left:auto;cursor:pointer;color:var(--red);" onclick="clearHistory()" title="Hapus semua riwayat">[CLEAR]</span></div>
      <div id="history-strip" class="hstrip"><div class="loading">SYNCING HISTORY...</div></div>
      <div class="section-title" style="margin-top:24px">Popular Series <span class="count" id="popular-count"></span></div>
      <div id="popular-strip" class="hstrip"><div class="loading">SYNCING POPULAR FEED...</div></div>
      <div class="section-title" style="margin-top:24px">Latest Episodes <span class="count" id="latest-count"></span></div>
      <div id="latest-grid" class="card-grid"><div class="loading">INITIALIZING NEURAL LINK...</div></div>
      <div class="pagination" id="latest-pagination"></div>
    </div>

    <div id="sec-search" class="section">
      <div class="section-title">Search Results <span class="count" id="search-count"></span></div>
      <div id="search-grid" class="card-grid"></div>
      <div class="pagination" id="search-pagination"></div>
    </div>

    <div id="sec-ongoing" class="section">
      <div class="section-title">Ongoing Series <span class="count" id="ongoing-count"></span></div>
      <div id="ongoing-grid" class="card-grid"><div class="loading">LOADING DATA STREAM...</div></div>
      <div class="pagination" id="ongoing-pagination"></div>
    </div>

    <div id="sec-completed" class="section">
      <div class="section-title">Completed Series <span class="count" id="completed-count"></span></div>
      <div id="completed-grid" class="card-grid"><div class="loading">LOADING DATA STREAM...</div></div>
      <div class="pagination" id="completed-pagination"></div>
    </div>

    <div id="sec-genres" class="section">
      <div class="section-title">Genre Directory</div>
      <div id="genre-chips" class="genre-grid"><div class="loading">SCANNING GENRE MATRIX...</div></div>
      <div id="genre-results" style="margin-top:24px">
        <div class="card-grid" id="genre-grid"></div>
        <div class="pagination" id="genre-pagination"></div>
      </div>
    </div>

    <div id="sec-schedule" class="section">
      <div class="section-title">Weekly Schedule</div>
      <div id="schedule-container"><div class="loading">RETRIEVING SCHEDULE DATA...</div></div>
    </div>

    <div id="sec-api-doc" class="section">
      <div class="section-title">API Documentation</div>
      <div class="api-doc" id="api-doc-content"></div>
    </div>

    <div id="modal" class="modal-overlay">
      <div class="modal-box" id="modal-box"></div>
    </div>
  </main>

  <div class="status-bar">
    <div><span class="status-dot"></span>DONGWAL v<%= version %> // SYSTEM ONLINE</div>
    <div class="status-bar-right">BUILD: <a href="https://www.instagram.com/octa.fiano/" target="_blank" rel="noopener">CYBER-EDITION BY FIANO</a></div>
  </div>

  <script>
    window.__DW_CONFIG__ = { version: "<%= version %>", sources: <%- JSON.stringify(sources) %> };
  </script>
  <script src="/js/index.js"></script>
</body>
</html>
